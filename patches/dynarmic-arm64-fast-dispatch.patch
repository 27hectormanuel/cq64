+    static constexpr size_t fast_dispatch_table_bits = 14;
+    static constexpr size_t FastDispatchIndex(u64 descriptor) {
+        return ((descriptor ^ (descriptor >> 32)) >> 1) & ((size_t(1) << fast_dispatch_table_bits) - 1);
