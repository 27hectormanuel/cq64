+    // Fast dispatch: a direct-mapped cache of location descriptor -> code, looked up by the
+    // dispatcher's emitted code before it falls back to GetOrEmit. Cleared whenever any block
+    // is invalidated or the code cache is reset.
+    struct FastDispatchEntry {
